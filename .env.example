# Copy to .env and edit. Real environment variables override this file.
# Never commit .env (it may contain the DB password).

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres@localhost:5432/plc_monitoring

HTTP_ADDR=:8080

# How often plc_metadata / pv_metadata are re-read (changes apply without restart)
CONFIG_RELOAD=10s

# "off" = web UI only, no PLC polling
ACQUISITION=on
